<?xml version="1.0"?>
<robot name="triorb">

  <!-- odom -->
  <link name="odom"/>

  <!-- X translation -->
  <link name="base_x_link"/>
  <joint name="base_x" type="prismatic">
    <parent link="odom"/>
    <child link="base_x_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1000" upper="1000" effort="1000" velocity="10"/>
  </joint>

  <!-- Y translation -->
  <link name="base_y_link"/>
  <joint name="base_y" type="prismatic">
    <parent link="base_x_link"/>
    <child link="base_y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="1000" velocity="10"/>
  </joint>

  <!-- Yaw rotation -->
  <link name="base_yaw_link"/>
  <joint name="base_yaw" type="continuous">
    <parent link="base_y_link"/>
    <child link="base_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Actual robot base -->
  <link name="base">

    <inertial>
      <origin xyz="0 0 -0.265" rpy="0 0 0"/>
      <mass value="120.95"/>
      <inertia
        ixx="6.25009" ixy="0.0" ixz="0.0"
        iyy="5.95074" iyz="0.0"
        izz="4.94383"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.51 0.60"/>
      </geometry>
      <material name="CardBoard">
        <color rgba="0.2667536437511444 0.17454615235328674 0.06440283358097076 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.51 0.60"/>
      </geometry>
    </collision>

  </link>

  <!-- Attach base to yaw frame -->
  <joint name="base_mount_joint" type="fixed">
    <parent link="base_yaw_link"/>
    <child link="base"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>

  <!-- Mount link -->
  <link name="mount"/>

  <joint name="base_to_mount" type="fixed">
    <parent link="base"/>
    <child link="mount"/>
    <origin xyz="0 0.015 0.30" rpy="0 0 1.57079632679"/>
  </joint>

</robot>
